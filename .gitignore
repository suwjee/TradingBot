# Dependencies and local environments restored from manifests.
/apps/chart/node_modules/
**/node_modules/
/.venv/
/venv/
/env/

# Language and test caches.
**/__pycache__/
*.py[cod]
/.pytest_cache/
**/.pytest_cache/
/.mypy_cache/
**/.mypy_cache/
/.ruff_cache/
**/.ruff_cache/
*.egg-info/
/.coverage
**/.coverage
/coverage/
/coverage.xml
**/coverage.xml
/htmlcov/
**/htmlcov/
/.benchmarks/
**/.benchmarks/
/.cache/
**/.cache/

# Rebuildable chart output and disposable working files.
/apps/chart/dist/
**/dist/
**/build/
**/cache/
**/caches/
**/tmp/
**/temp/
**/temporary/
**/.vite/
*.tmp
*.temp
*.bak
*.pid
*.swp
*.swo
*.orig
*.rej
*.part
*.crdownload
*~

# Machine-local chart state. The curated BaseLine RAW reference is explicitly
# retained because it is reproducibility evidence, not ordinary acquired state.
/apps/chart/state/cache/
/apps/chart/state/secret/
/apps/chart/state/tmp/
/apps/chart/state/data/raw/*
!/apps/chart/state/data/raw/BaseLine/
!/apps/chart/state/data/raw/BaseLine/**
/apps/chart/state/data/RAW/*
!/apps/chart/state/data/RAW/BaseLine/
!/apps/chart/state/data/RAW/BaseLine/**

# Reconstructible Graphify and verification execution residue. Reports, graphs,
# manifests, inventories, and historical evidence remain eligible for Git.
/engineering/archive/repository-graphify/cache/
/graphify-out/cache/
/engineering/archive/repository-graphify/**/cache/
/engineering/archive/repository-graphify/**/last_query_stamp
/engineering/archive/repository-graphify/**/raw-run/.graphify_*.json
/engineering/archive/repository-graphify/**/raw-run/.graphify_root
/engineering/archive/docs/validation-temp/
/engineering/verification/**/runtime-server.*

# Original archive snapshots that contain rebuildable cache/build files stay local.
/engineering/verification/history/cleanup-2026-09-29/pre-cleanup-project.zip
/engineering/verification/single-root-2026-09-29/project-before-migration.zip

# Local editor and operating-system state. Never track real environment files.
.env
.env.*
!.env.example
/.idea/
/.vscode/
.DS_Store
Thumbs.db
Desktop.ini
/.worktrees/
/.superpowers/
