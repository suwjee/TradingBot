* text=auto

# Engine and exact-source references retain their original byte identity.
engine/** -text

# Keep the companion reference's renderer snapshots byte-exact at checkout.
apps/chart/src/chart/indicator-renderer.js text eol=lf
apps/chart/src/chart/primary-structure.js text eol=lf
apps/chart/src/chart/true-false-label.js text eol=lf

*.bat text eol=crlf
*.ps1 text eol=crlf

# Markdown uses trailing spaces for intentional hard line breaks.
*.md whitespace=-blank-at-eol
