    {
      "id": "B09-30-S01",
      "path": "engine/bridge/trading_pipeline.py",
      "source_span": [
        1271,
        1334
      ],
      "interpretation": "Only normalized blue enables formation mapping; emitted color is separately formatted from original color. The current Order cause uses the original color string, not the lowercased formation key. Parent A price/stop are recorded fields, and parent Order is looked up independently by physical identity; no replacement by current Order. Both attributes are obtained before the null test; zero is allowed, source time is retained as supplied and integer index conversion is not a bounds check.",
      "source_anchor": "https://github.com/suwjee/TradingBot/blob/466eb875070f02cd0dbfb105033422bbe2fd8c70/engine/bridge/trading_pipeline.py#L1271-L1334",
