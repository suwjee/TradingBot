+class _RedSDecisionIndex:
+    """Run-scoped suffix minimum over unaccepted Red S decision times.
+
+    A Red S competes with an E precisely when its source time is strictly
+    later than the E parent's source, it is not yet E-owned, and its decision
+    event strictly precedes that parent's stop. The index answers this same
+    existential predicate without rescanning all eligible Red S rows.
+
+    The original source order and duplicate physical identities are retained.
+    Only accepted E sources are removed; chronology remains authoritative.
+    """
+
+    def __init__(self, rows: tuple[object, ...], accepted: set[tuple[datetime, int]]) -> None:
+        length = len(rows)
+        base = 1 << (length - 1).bit_length()
+        self._base = base
+        self._tree: list[datetime | None] = [None] * (2 * base)
+        locations: dict[tuple[datetime, int], list[int]] = {}
+        for offset, item in enumerate(rows):
+            identity = (item.source_time, int(item.source_index))
+            locations.setdefault(identity, []).append(offset)
+            if identity not in accepted:
+                self._tree[base + offset] = item.decision_event_time
+        self._locations = locations
+        for index in range(base - 1, 0, -1):
+            self._tree[index] = self._earlier(self._tree[2 * index], self._tree[2 * index + 1])
+
+    @staticmethod
+    def _earlier(a: datetime | None, b: datetime | None) -> datetime | None:
+        if a is None:
+            return b
+        if b is None:
+            return a
+        return a if a <= b else b
+
+    def accept(self, identity: tuple[datetime, int]) -> None:
+        for offset in self._locations.get(identity, ()):
+            position = self._base + offset
+            if self._tree[position] is None:
+                continue
+            self._tree[position] = None
+            position //= 2
+            while position:
+                self._tree[position] = self._earlier(
+                    self._tree[position * 2], self._tree[position * 2 + 1]
+                )
+                position //= 2
+
+    def has_earlier_after(self, first: int, deadline: datetime) -> bool:
+        """True iff any surviving row at index >= first is < deadline."""
+        left, right = self._base + first, self._base * 2
+        while left < right:
+            if left & 1:
+                value = self._tree[left]
+                if value is not None and value < deadline:
+                    return True
+                left += 1
+            if right & 1:
+                right -= 1
+                value = self._tree[right]
+                if value is not None and value < deadline:
+                    return True
+            left //= 2
+            right //= 2
+        return False
+
+
+def _e_order_choice_key(match: OrderMatch) -> tuple[datetime, int]:
+    """Canonical E selection priority: stop chronology, then latest First."""
+    return match[6][2], -int(match[1].first_idx)
+
+
+def _e_sorted_eligible_route(route: Sequence[OrderMatch]) -> list[OrderMatch]:
+    """Preserve legacy stable ties while avoiding unnecessary singleton sort."""
+    eligible = [item for item in route if item[6] is not None]
+    if len(eligible) > 1:
